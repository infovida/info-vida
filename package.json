{
  "name": "infovida",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:changed": "jest --onlyChanged --watch=false",
    "test:e2e:android": "maestro test .maestro",
    "validate": "npm run lint && npm run typecheck && npm run test:coverage",
    "doctor": "npx expo-doctor",
    "eas:build": "eas build",
    "eas:update": "eas update"
  },
  "dependencies": {
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.7",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  }
}
